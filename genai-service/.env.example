# GenAI Service — Environment Variables
# Copy this file to .env and fill in your values.

# --- LLM Provider Configuration ---
# Set the provider: "openrouter", "google", "nvidia", "logos", or "ollama"
# LLM_PROVIDER=nvidia
# LLM_MODEL=moonshotai/kimi-k2.6
# Logos example:
# LLM_PROVIDER=logos
# LLM_MODEL=openai/gpt-oss-120b
# Ollama on the Docker Desktop host (macOS/Windows):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b-instruct
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- API Keys ---
# Depending on your chosen LLM_PROVIDER, provide the corresponding key:
NVIDIA_NIM_API_KEY=your-nvidia-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# LOGOS_API_KEY=your-logos-api-key-here

# --- Optional Parameters (defaults shown) ---
# LLM_TEMPERATURE=0.3
# For Ollama, use LLM_TEMPERATURE=0.0 for more deterministic structured output.
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:3000,http://localhost:8082

# --- Internal service authentication ---
# Must match INTERNAL_SERVICE_TOKEN used by the Spring services.
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token

# --- Daily Digest External Sources ---
# Optional: improves GitHub API rate limits for curated repo release/PR fetching.
# GITHUB_TOKEN=your-github-token-here

# Optional: enables GNews source fetching. If omitted, digest jobs continue with a warning.
# GNEWS_API_KEY=your-gnews-api-key-here

# --- Opt-in live integration tests ---
# These call real external APIs/LLM endpoints and are skipped unless explicitly enabled.
# RUN_DIGEST_PROVIDER_INTEGRATION=1
# RUN_DIGEST_LLM_INTEGRATION=1
# RUN_OLLAMA_INTEGRATION=1
