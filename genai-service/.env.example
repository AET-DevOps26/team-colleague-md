# GenAI Service — Environment Variables
# Copy this file to .env and fill in your values.

# --- LLM Provider Configuration ---
# Set the provider: "openrouter", "google", or "nvidia"
# LLM_PROVIDER=nvidia
# LLM_MODEL=moonshotai/kimi-k2.6

# --- API Keys ---
# Depending on your chosen LLM_PROVIDER, provide the corresponding key:
NVIDIA_NIM_API_KEY=your-nvidia-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# --- Optional Parameters (defaults shown) ---
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=300
# CORS_ORIGINS=http://localhost:3000,http://localhost:8082
