meta {
  name: Update ban status (admin)
  type: http
  seq: 16
}

patch {
  url: {{userBaseUrl}}/api/v1/users/{{otherUserId}}/ban
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "banned": true
  }
}

docs {
  Admin-only. An admin cannot ban themselves (403) — it would lock the acting administrator out
  of the panel needed to undo it (ADR-0020).
}
