meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{userBaseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  // Carry the access token across services (ADR-0001: identity travels in the token).
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().accessToken);
    bru.setEnvVar("ownUserId", res.getBody().user.id);
  }
}
