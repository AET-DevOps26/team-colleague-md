meta {
  name: Update user role (admin)
  type: http
  seq: 15
}

patch {
  url: {{userBaseUrl}}/api/v1/users/{{otherUserId}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "role": "VERIFIED"
  }
}

docs {
  Admin-only. An admin cannot change their OWN role (403) — self-demotion could strip the
  platform of its last administrator with no way back in through the UI (ADR-0020).
}
