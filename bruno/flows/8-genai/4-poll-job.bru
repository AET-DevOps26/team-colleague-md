meta {
  name: Poll digest job
  type: http
  seq: 4
}

get {
  url: {{genaiBaseUrl}}/api/v1/genai/digests/jobs/{{jobId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.status: isDefined
}

docs {
  Assert the job's status field exists (QUEUED/RUNNING/SUCCEEDED/FAILED); never assert generated content.
}
