meta {
  name: Personal feed
  type: http
  seq: 6
}

get {
  url: {{recBaseUrl}}/api/v1/feed/personal
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  Cross-service identity end to end: user-service token authorises a recommendation-service call (200, not 401).
}
