meta {
  name: Create digest post
  type: http
  seq: 2
}

post {
  url: {{contentBaseUrl}}/api/v1/posts/digest
  body: json
  auth: none
}

headers {
  X-Internal-Service-Token: {{internalServiceToken}}
}

body:json {
  {
    "title": "Bruno internal digest",
    "content": "Digest markdown body created via the internal-service flow."
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

docs {
  System-authored post (no user identity). deletePost is author-only (PostService.mustOwnEditablePost), so this leaves a digest post behind by design.
}
