meta {
  name: 1 Login
  type: http
  seq: 1
}

post {
  url: {{userBaseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  // Step 1 of the cross-service flow: mint the token at user-service and stash it.
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().accessToken);
  }
}
