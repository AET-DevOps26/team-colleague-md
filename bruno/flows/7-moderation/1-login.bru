meta {
  name: Login (admin)
  type: http
  seq: 1
}

post {
  url: {{userBaseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.user.role: eq ADMIN
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().accessToken);
    bru.setEnvVar("ownUserId", res.getBody().user.id);
  }
}

docs {
  Requires the env's userEmail to be an ADMIN (local default: alex@example.com).
}
