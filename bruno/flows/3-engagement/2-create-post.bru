meta {
  name: Create post
  type: http
  seq: 2
}

post {
  url: {{contentBaseUrl}}/api/v1/posts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Bruno engagement flow",
    "content": "Published body for the engagement flow.",
    "topics": ["ai"],
    "status": "PUBLISHED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  bru.setEnvVar("postId", res.getBody().id);
}
