meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{userBaseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{flowEmail}}",
    "password": "{{userPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isDefined
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().accessToken);
    bru.setEnvVar("ownUserId", res.getBody().user.id);
  }
}
