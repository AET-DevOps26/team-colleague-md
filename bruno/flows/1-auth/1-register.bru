meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{userBaseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{flowUsername}}",
    "email": "{{flowEmail}}",
    "password": "{{userPassword}}"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  // unique account per run so register never collides on a re-run
  // base36 keeps username <= 20 chars (flowuser + 8 = 16); plain ms timestamp overflows the 20-char cap
  const stamp = Date.now().toString(36);
  bru.setEnvVar("flowUsername", "flowuser" + stamp);
  bru.setEnvVar("flowEmail", "flowuser" + stamp + "@example.com");
  // LOCAL ONLY — do not commit. seed default password (scripts/seed/data/users.ts).
  // setVar (runtime store) — the secret-declared {{userPassword}} reads this, not setEnvVar.
  if (!bru.getVar("userPassword")) bru.setVar("userPassword", "Password123!");
}

docs {
  Self-provisions a throwaway account; password is the env secret {{userPassword}}.
}
