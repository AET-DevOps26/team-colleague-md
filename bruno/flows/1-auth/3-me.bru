meta {
  name: Current user
  type: http
  seq: 3
}

get {
  url: {{userBaseUrl}}/api/v1/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.email: eq {{flowEmail}}
}

docs {
  Cross-check: the userId-claim token resolves to the account we just created.
}
