meta {
  name: Update post
  type: http
  seq: 6
}

put {
  url: {{contentBaseUrl}}/api/v1/posts/{{postId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Updated title from Bruno",
    "content": "Updated body content.",
    "topics": ["ai"],
    "status": "PUBLISHED"
  }
}
