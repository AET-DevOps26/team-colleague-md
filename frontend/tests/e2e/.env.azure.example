# Azure VM (prod compose). Unlike the other two targets this one is not committed filled in: the
# VM's public IP is assigned per deploy, so there is no stable value to check in.
#
#   terraform -chdir=infra/terraform output vm_public_ip    # the host
#   cp tests/e2e/.env.azure.example tests/e2e/.env.azure    # then fill in the IP below
#   VM_HOST=<public-ip> ./scripts/seed-vm.sh                # seed it (from the repo root)
#   set -a && . tests/e2e/.env.azure && set +a && npm test
BASE_URL=http://<vm-public-ip>
SEED_PASSWORD=Password123!
